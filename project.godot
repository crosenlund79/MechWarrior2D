; Engine configuration file.
; Thawborn (formerly Heat Signature) — Godot 4.7.2, GDScript, Compatibility renderer.

config_version=5

[application]

config/name="Thawborn"
config/description="Top-down vehicular hunting/survival in the scorched, thawed Antarctic wasteland."
config/version="0.3.0"
run/main_scene="res://scenes/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Thawborn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Log="*res://src/core/session_log.gd"
Assets="*res://src/core/asset_resolver.gd"
Audio="*res://src/core/audio_service.gd"
Settings="*res://src/core/settings_service.gd"
Saves="*res://src/persistence/save_service.gd"
Session="*res://src/sim/game_session.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[internationalization]

locale/translations=PackedStringArray("res://locale/strings.en.translation", "res://locale/strings.da.translation")
locale/fallback="en"

[physics]

2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.2, 0.16, 0.12, 1)
