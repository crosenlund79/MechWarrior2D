{
	"_note": "Campaign beats (THE KERN-7 CROSSING). Each beat fires once when its trigger matches a game event: {event: start|arrive|search|kill|flag|paid|activate, node, poi, creature, flag} and every flag in 'requires' is set and none in 'unless'. 'do' runs in order: cards (dialogue: [speaker, text-key]), flag, objective {text, node, poi}, money, act, contract (posts an authored contract), ending. Text lives in tools/locale_src.py (STORY_*). Speakers: data 'cast' (portrait = ui.portrait_<id>).",
	"cast": {
		"greta": {"name": "CAST_GRETA", "role": "CAST_GRETA_ROLE"},
		"konrad": {"name": "CAST_KONRAD", "role": "CAST_KONRAD_ROLE"},
		"mika": {"name": "CAST_MIKA", "role": "CAST_MIKA_ROLE"},
		"oskar": {"name": "CAST_OSKAR", "role": "CAST_OSKAR_ROLE"},
		"henrik": {"name": "CAST_HENRIK", "role": "CAST_HENRIK_ROLE"},
		"ilse": {"name": "CAST_ILSE", "role": "CAST_ILSE_ROLE"},
		"aurich": {"name": "CAST_AURICH", "role": "CAST_AURICH_ROLE"},
		"radio": {"name": "CAST_RADIO", "role": "CAST_RADIO_ROLE"}
	},
	"acts": {"1": "ACT_1", "2": "ACT_2", "3": "ACT_3", "4": "ACT_EPILOGUE"},
	"beats": [
		{"id": "intro", "when": {"event": "start"}, "unless": ["legacy_save"],
			"do": [{"cards": [["greta", "STORY_INTRO_1"], ["greta", "STORY_INTRO_2"]]},
				{"objective": {"text": "OBJ_FIRST_JOB"}}]},
		{"id": "first_outing", "when": {"event": "arrive"}, "requires": [], "unless": ["visited_territory"], "territory": true,
			"do": [{"flag": "visited_territory"}]},
		{"id": "wreck_arrives", "when": {"event": "arrive", "node": "ersthafen"}, "requires": ["visited_territory"], "unless": ["kern7_received", "legacy_save"],
			"do": [{"flag": "wreck_arrived"},
				{"cards": [["greta", "STORY_WRECK_1"]]},
				{"objective": {"text": "OBJ_WRECK", "poi": "konrad_wreck"}}]},
		{"id": "kern7", "when": {"event": "search", "poi": "konrad_wreck"},
			"do": [{"cards": [["konrad", "STORY_KONRAD_1"], ["konrad", "STORY_KONRAD_2"], ["radio", "STORY_RECORDER"], ["greta", "STORY_KERN7_GRETA"]]},
				{"flag": "kern7_received"},
				{"contract": "ct_alt_eisback"},
				{"objective": {"text": "OBJ_MIKA", "node": "ersthafen"}}]},
		{"id": "mika_meets", "when": {"event": "flag", "flag": "kern7_received"}, "requires": ["kern7_received"],
			"do": [{"cards": [["mika", "STORY_MIKA_1"], ["mika", "STORY_MIKA_2"]]},
				{"objective": {"text": "OBJ_ALT_EISBACK", "node": "wrackkueste"}}]},
		{"id": "alt_eisback_down", "when": {"event": "kill", "creature": "eisback_alt"},
			"do": [{"flag": "act1_hunt_done"},
				{"cards": [["radio", "STORY_EISBACK_DOWN"], ["mika", "STORY_EISBACK_MIKA"]]},
				{"objective": {"text": "OBJ_ROSTMARK", "node": "grauwacht"}}]},
		{"id": "act2", "when": {"event": "arrive"}, "region": "rostmark", "requires": ["kern7_received"], "unless": ["act2"],
			"do": [{"flag": "act2"}, {"act": 2}]},
		{"id": "grauwacht", "when": {"event": "arrive", "node": "grauwacht"}, "requires": ["kern7_received"],
			"do": [{"cards": [["oskar", "STORY_OSKAR_1"], ["oskar", "STORY_OSKAR_2"]]},
				{"contract": "ct_junker_crew"},
				{"objective": {"text": "OBJ_EISENFURT", "node": "eisenfurt"}}]},
		{"id": "junkers_scattered", "when": {"event": "flag", "flag": "junkers_scattered"},
			"do": [{"cards": [["oskar", "STORY_JUNKERS_DONE"]]}]},
		{"id": "eisenfurt", "when": {"event": "arrive", "node": "eisenfurt"}, "requires": ["kern7_received"],
			"do": [{"cards": [["henrik", "STORY_HENRIK_1"], ["henrik", "STORY_HENRIK_2"]]},
				{"flag": "henrik_briefed"},
				{"contract": "ct_dornkoenig"},
				{"objective": {"text": "OBJ_STATION", "node": "glaswueste", "poi": "research_station"}}]},
		{"id": "station", "when": {"event": "search", "poi": "research_station"},
			"do": [{"cards": [["ilse", "STORY_ILSE_1"], ["ilse", "STORY_ILSE_2"], ["ilse", "STORY_ILSE_3"]]},
				{"flag": "truth_known"},
				{"money": 600},
				{"objective": {"text": "OBJ_STAHLHEIM", "node": "stahlheim"}}]},
		{"id": "act3", "when": {"event": "arrive"}, "region": "anflug", "requires": ["kern7_received"], "unless": ["act3"],
			"do": [{"flag": "act3"}, {"act": 3},
				{"cards": [["mika", "STORY_LAST_ROAD_1"], ["radio", "STORY_LAST_ROAD_2"]]}]},
		{"id": "delivery", "when": {"event": "arrive", "node": "stahlheim"}, "requires": ["kern7_received"], "unless": ["kern7_delivered"],
			"do": [{"flag": "kern7_delivered"},
				{"cards": [["aurich", "STORY_AURICH_1"], ["aurich", "STORY_AURICH_2"], ["aurich", "STORY_AURICH_3"]]},
				{"money": 8000},
				{"flag": "finale_started"},
				{"objective": {"text": "OBJ_TRANSMITTERS", "node": "hochstrasse"}}]},
		{"id": "transmitter_1", "when": {"event": "activate"}, "count": 1,
			"do": [{"cards": [["aurich", "STORY_MAST_1"]]}]},
		{"id": "transmitter_2", "when": {"event": "activate"}, "count": 2,
			"do": [{"cards": [["aurich", "STORY_MAST_2"]]}]},
		{"id": "transmitter_3", "when": {"event": "activate"}, "count": 3,
			"do": [{"flag": "transmitters_on"},
				{"cards": [["aurich", "STORY_MAST_3"], ["mika", "STORY_KALTVATER_COMES"]]},
				{"objective": {"text": "OBJ_KALTVATER"}}]},
		{"id": "kaltvater_slain", "when": {"event": "kill", "creature": "kaltvater"},
			"do": [{"flag": "campaign_complete"}, {"act": 4},
				{"cards": [["aurich", "STORY_VICTORY_1"], ["mika", "STORY_VICTORY_2"]]},
				{"money": 5000},
				{"ending": true},
				{"objective": {"text": "OBJ_FREE"}}]}
	],
	"ending": [
		{"image": "ui.photo_combat", "text": "END_1"},
		{"image": "ui.continent_map", "text": "END_2"},
		{"image": "ui.photo_garage", "text": "END_3"},
		{"image": "ui.logo", "text": "END_4"}
	],
	"credits": [
		["CREDITS_GAME", "Thawborn"],
		["CREDITS_CREATOR", "CREDITS_CREATOR_NAME"],
		["CREDITS_MUSIC", "“Where the Ice Once Lay”"],
		["CREDITS_ILLUSTRATIONS", "CREDITS_CREATOR_NAME"],
		["CREDITS_ENGINE", "Godot Engine 4.7"],
		["CREDITS_ASSIST", "Claude (Anthropic)"],
		["CREDITS_THANKS", "CREDITS_THANKS_TEXT"]
	]
}
